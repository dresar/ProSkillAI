# Neon Serverless PostgreSQL Database URLs
# Pooled connection string for serverless runtime (AWS ap-southeast-1 Singapore)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct unpooled connection string for migrations and DDL
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xyz.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Initial Admin Credentials (used by seed script, never committed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your-strong-password-here"

# Authentication & Session Security (minimum 32 random hex characters)
SESSION_SECRET="your-random-32-byte-hex-secret-here"

# GitHub REST API Token (Server-only for importing SKILL.md from repositories)
GITHUB_TOKEN="ghp_your_github_token_here"

# Public Site Configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
